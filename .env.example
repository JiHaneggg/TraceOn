# 이 파일을 .env로 복사해서 사용한다. (.env는 Git에 올라가지 않는다)
#   PowerShell: Copy-Item .env.example .env
#
# docker compose와 백엔드 bootRun이 같은 .env를 사용한다.

# Neo4j 비밀번호: 8자 이상 필수. 최초 실행 시 이 값으로 계정이 만들어진다.
NEO4J_PASSWORD=
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# 호스트(IntelliJ / bootRun)에서 실행할 때의 접속 주소.
# docker compose의 backend 컨테이너는 bolt://neo4j:7687을 사용한다.
NEO4J_URI=bolt://localhost:7687

SERVER_PORT=8080

# Spring의 고정 읽기 템플릿은 Neo4j transactional HTTP로 직접 조회한다.
NEO4J_HTTP_URL=http://127.0.0.1:7474
# 시연 대상 목록·분석 이력 경로는 backend/ 작업 디렉터리 기준이다.
TRACEON_MANIFEST=../data/processed/HI-Small-MVP/manifest.json
TRACEON_HISTORY_DB=../data/history/spring-analysis.sqlite3
RULE_URL=http://127.0.0.1:8091/v1/rules/score
RAG_URL=http://127.0.0.1:8092

# 선택: RAG OpenAI 보고서 모드. 실제 프로세스 환경변수로 설정한다.
# RAG는 이 .env 파일을 자동 로드하지 않는다. 기본 template 모드는 API를 호출하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=
