# 이 파일을 .env로 복사해서 사용한다. (.env는 Git에 올라가지 않는다)
#   PowerShell: Copy-Item .env.example .env
#
# docker compose와 백엔드 bootRun이 같은 .env를 사용한다.

# Neo4j 비밀번호: 8자 이상 필수. 최초 실행 시 이 값으로 계정이 만들어진다.
NEO4J_PASSWORD=
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# 호스트(IntelliJ / bootRun)에서 실행할 때의 접속 주소.
# docker compose의 backend 컨테이너는 bolt://neo4j:7687을 사용한다.
NEO4J_URI=bolt://localhost:7687

SERVER_PORT=8080
