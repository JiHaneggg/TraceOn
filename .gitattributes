# 저장소에는 LF로 저장하고, 체크아웃 시 OS에 맞게 변환한다.
* text=auto

# 리눅스 컨테이너에서 실행되는 파일은 항상 LF (CRLF면 Docker에서 실행 실패)
*.sh       text eol=lf
gradlew    text eol=lf
Dockerfile text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Windows 전용 스크립트는 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# 바이너리
*.jar binary
*.png binary
*.jpg binary
