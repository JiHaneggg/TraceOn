[
  {
    "type": "function",
    "name": "search_regulations",
    "description": "공식 안내 자료를 검색하고 원문 URL, 절, 해시, chunkId를 받습니다. 검색 일치는 위반 판정이 아닙니다.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "jurisdiction": {
          "type": "string",
          "enum": [
            "KR",
            "US",
            "CA",
            "ALL"
          ]
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "official_guidance",
            "law",
            "foreign_typology",
            "bank_internal_policy"
          ]
        },
        "legalAsOf": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "build_evidence_context",
    "description": "Spring에서 받은 라벨 없는 Graph JSON과 룰 결과를 검증하고 보고서용 사실·문서 근거를 만듭니다. DB 조회나 임의 Cypher 실행 기능은 없습니다.",
    "parameters": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "graph"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "validate_report_draft",
    "description": "숫자 등 구조화 사실과 원문 인용을 검증합니다. 자유 문장 의미의 검증과 최종 보고 결정은 사람 검토가 필요합니다.",
    "parameters": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "draft": {
          "type": "object"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "graph",
        "draft"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "generate_review_report",
    "description": "Verified context to human-review report. Default template mode calls no LLM. Explicit openai mode requires server configuration and restricts the model to selecting provided IDs.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph"
      ],
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "template",
            "openai"
          ]
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  {
    "type": "function",
    "name": "get_citation",
    "description": "Return version-pinned source URL, section, original text, highlight offsets and snapshot integrity status.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunkId": {
          "type": "string"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "chunkId",
        "corpusSha256"
      ]
    }
  },
  {
    "type": "function",
    "name": "resolve_report_fact",
    "description": "Recompute a report fact from the same backend graph/rule/query and return its exact transactions.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "factId": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        }
      },
      "required": [
        "graph",
        "factId",
        "contextId",
        "corpusSha256"
      ]
    }
  },
  {
    "type": "function",
    "name": "verify_review_report",
    "description": "Check complete report facts, pinned source snapshots and controlled rendered content. No legal/semantic decision.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "report": {
          "type": "object"
        }
      },
      "required": [
        "graph",
        "report"
      ]
    }
  },
  {
    "type": "function",
    "name": "prepare_review_report",
    "description": "Build context, generate a human-review draft and verify facts, citations, snapshots and rendering. Template mode calls no LLM.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "template",
            "openai"
          ],
          "default": "template"
        }
      },
      "required": [
        "graph"
      ]
    }
  },
  {
    "type": "function",
    "name": "assess_evidence_fit",
    "description": "정해진 룰별 원문 연결과 관찰 가능한 조건을 점검하고 근거 부족·미확인 항목을 받습니다. 범죄·보고 의무·의미 검증 판정이 아니며 원본 스냅샷 확인은 보고서 전체 검사에서 수행합니다.",
    "parameters": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "object"
        },
        "ruleResult": {
          "type": "object"
        },
        "query": {
          "type": "string"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "graph"
      ],
      "additionalProperties": false
    }
  }
]
