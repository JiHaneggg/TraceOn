{
  "openapi": "3.1.0",
  "info": {
    "title": "TraceOn RAG API",
    "version": "0.7.0",
    "description": "Grounded local retrieval, explicit scope checks and review report generation. Template mode is offline; explicitly configured OpenAI mode selects verified IDs only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8092"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Index health and corpus version"
          }
        }
      }
    },
    "/v1/rag/search": {
      "post": {
        "operationId": "search_regulations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500
                  },
                  "topK": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 3
                  },
                  "jurisdiction": {
                    "enum": [
                      "KR",
                      "US",
                      "CA",
                      "ALL"
                    ],
                    "default": "KR"
                  },
                  "sourceKind": {
                    "enum": [
                      "official_guidance",
                      "law",
                      "foreign_typology",
                      "bank_internal_policy",
                      null
                    ]
                  },
                  "legalAsOf": {
                    "type": "string",
                    "format": "date",
                    "description": "Requires verified legal validity interval; fails closed when unavailable."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Primary hits are the best original chunk per source/version/section. topK counts these groups. supportingChunks preserves up to two additional original passages per group with their own IDs/hashes/locators. Status matched is not semantic answerability; known missing policy/customer/pricing/law sources abstain. New corpora label domestic statutes, domestic official guidance and foreign references separately. Explicit law/article selectors never substitute a different indexed article. Historical/future applicability requires a verified interval; none is invented for collected snapshots.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "413": {
            "description": "Body exceeds 2MB"
          }
        }
      }
    },
    "/v1/rag/context": {
      "post": {
        "operationId": "build_evidence_context",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified report facts, evidence transaction IDs, retrieved citations, scope and contextId"
          },
          "400": {
            "description": "Malformed graph, truth leakage, altered rule evidence or invalid query"
          },
          "413": {
            "description": "Body exceeds 2MB"
          },
          "409": {
            "description": "Corpus unavailable/integrity error, or legacy_corpus_read_only: new context/report/assessment generation cannot select a corpus predating the active query-scope policy. Stored report verification and citation/fact resolution remain available."
          }
        }
      }
    },
    "/v1/rag/validate": {
      "post": {
        "operationId": "validate_report_draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "graph",
                  "draft"
                ],
                "properties": {
                  "graph": {
                    "type": "object"
                  },
                  "ruleResult": {
                    "type": "object"
                  },
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500
                  },
                  "draft": {
                    "$ref": "#/components/schemas/Draft"
                  },
                  "corpusSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "Pinned corpus version. Unavailable archives return 409 without fallback."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "valid/errors for structured facts and verbatim citations; human review remains required"
          },
          "400": {
            "description": "Invalid input"
          },
          "413": {
            "description": "Body exceeds 2MB"
          },
          "409": {
            "description": "Corpus unavailable/integrity error, or legacy_corpus_read_only: new context/report/assessment generation cannot select a corpus predating the active query-scope policy. Stored report verification and citation/fact resolution remain available."
          }
        }
      }
    },
    "/v1/rag/report": {
      "post": {
        "operationId": "generate_review_report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "graph"
                ],
                "properties": {
                  "graph": {
                    "type": "object"
                  },
                  "ruleResult": {
                    "type": "object"
                  },
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500
                  },
                  "mode": {
                    "enum": [
                      "template",
                      "openai"
                    ],
                    "default": "template"
                  },
                  "corpusSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "Pinned corpus version. Unavailable archives return 409 without fallback."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review-only report JSON, Markdown, observations/fact IDs, citations and structured validation; no final STR submission."
          },
          "400": {
            "description": "Invalid input"
          },
          "503": {
            "description": "OpenAI not configured, refused, incomplete or invalid response; no silent template fallback."
          },
          "409": {
            "description": "Corpus unavailable/integrity error, or legacy_corpus_read_only: new context/report/assessment generation cannot select a corpus predating the active query-scope policy. Stored report verification and citation/fact resolution remain available."
          }
        }
      }
    },
    "/v1/rag/citations/{chunkId}": {
      "get": {
        "operationId": "get_citation",
        "parameters": [
          {
            "name": "chunkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "corpusSha256",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Pinned corpus version. Unavailable archives return 409 without fallback."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pinned source metadata/text, full section and highlight. sourceVerification is snapshot_checked or index_only. No live fetch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitationResolution"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID/hash/query"
          },
          "404": {
            "description": "Unknown chunk"
          },
          "409": {
            "description": "Unavailable version or source integrity conflict"
          }
        }
      }
    },
    "/v1/rag/facts/resolve": {
      "post": {
        "operationId": "resolve_report_fact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "graph": {
                    "type": "object",
                    "description": "Backend label-free Graph JSON 1.0; 1..2000 edges, string amounts, windowStart/asOf, targetTxId"
                  },
                  "ruleResult": {
                    "type": "object",
                    "description": "Optional exact existing rule API result including config; recomputed and verified"
                  },
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500
                  },
                  "corpusSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "Pinned corpus version. Unavailable archives return 409 without fallback."
                  },
                  "factId": {
                    "type": "string",
                    "maxLength": 250
                  },
                  "contextId": {
                    "type": "string"
                  }
                },
                "required": [
                  "graph",
                  "factId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified fact, exact transactions, graph hash and scope. Use the same generation request/context.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactResolution"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input"
          },
          "404": {
            "description": "Unknown evidence ID"
          },
          "409": {
            "description": "Unavailable corpus/context or source integrity conflict"
          },
          "413": {
            "description": "Body exceeds 2MB"
          },
          "503": {
            "description": "Requested model unavailable; no silent fallback"
          }
        }
      }
    },
    "/v1/rag/reports/verify": {
      "post": {
        "operationId": "verify_review_report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "graph": {
                    "type": "object"
                  },
                  "ruleResult": {
                    "type": "object"
                  },
                  "query": {
                    "type": "string"
                  },
                  "report": {
                    "type": "object"
                  }
                },
                "required": [
                  "graph",
                  "report"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Separate amount/time/count/citation/coverage/snapshot/rendered content checks. valid=false is a completed negative verification. Human review required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteReportVerification"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input"
          },
          "404": {
            "description": "Unknown evidence ID"
          },
          "409": {
            "description": "Unavailable corpus/context or source integrity conflict"
          },
          "413": {
            "description": "Body exceeds 2MB"
          },
          "503": {
            "description": "Requested model unavailable; no silent fallback"
          }
        }
      }
    },
    "/v1/rag/reports/prepare": {
      "post": {
        "operationId": "prepare_review_report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "graph": {
                    "type": "object",
                    "description": "Backend label-free Graph JSON 1.0; 1..2000 edges, string amounts, windowStart/asOf, targetTxId"
                  },
                  "ruleResult": {
                    "type": "object",
                    "description": "Optional exact existing rule API result including config; recomputed and verified"
                  },
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500
                  },
                  "corpusSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "Pinned corpus version. Unavailable archives return 409 without fallback."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "template",
                      "openai"
                    ],
                    "default": "template"
                  }
                },
                "required": [
                  "graph"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Context, review report and complete verification in one response. Inspect verification.valid before marking evidence as verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreparedReviewReport"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input"
          },
          "404": {
            "description": "Unknown evidence ID"
          },
          "409": {
            "description": "Corpus unavailable/integrity error, or legacy_corpus_read_only: new context/report/assessment generation cannot select a corpus predating the active query-scope policy. Stored report verification and citation/fact resolution remain available."
          },
          "413": {
            "description": "Body exceeds 2MB"
          },
          "503": {
            "description": "Requested model unavailable; no silent fallback"
          }
        }
      }
    },
    "/v1/rag/evidence/assess": {
      "post": {
        "operationId": "assess_evidence_fit",
        "description": "Recompute rules and assess required source roles, exact curated anchors, observed data conditions and missing context. Does not authenticate the ledger or make a semantic/legal decision. Legacy pinned corpora without a policy return not_configured.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment completed, including insufficient-evidence outcomes. Original snapshots are checked separately during report verification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceAssessmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid graph/rules/input"
          },
          "409": {
            "description": "Corpus unavailable/integrity error, or legacy_corpus_read_only: new context/report/assessment generation cannot select a corpus predating the active query-scope policy. Stored report verification and citation/fact resolution remain available."
          },
          "413": {
            "description": "Body exceeds 2MB"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContextRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graph"
        ],
        "properties": {
          "graph": {
            "type": "object",
            "description": "Backend label-free Graph JSON 1.0; 1..2000 edges, string amounts, windowStart/asOf, targetTxId"
          },
          "ruleResult": {
            "type": "object",
            "description": "Optional exact existing rule API result including config; recomputed and verified"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "corpusSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Pinned corpus version. Unavailable archives return 409 without fallback."
          }
        }
      },
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contextId",
          "facts",
          "citations"
        ],
        "properties": {
          "contextId": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "factId",
                "value"
              ],
              "properties": {
                "factId": {
                  "type": "string"
                },
                "value": {}
              }
            }
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chunkId",
                "quote"
              ],
              "properties": {
                "chunkId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "CitationResolution": {
        "type": "object",
        "required": [
          "corpusSha256",
          "citation",
          "section",
          "sourceVerification",
          "links"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string"
          },
          "corpusSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "citation": {
            "type": "object",
            "required": [
              "chunkId",
              "url",
              "section",
              "text",
              "textSha256",
              "sourceSha256",
              "locator"
            ],
            "properties": {
              "chunkId": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "section": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "textSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "locator": {
                "type": "object"
              }
            }
          },
          "section": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chunkIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "documentStart": {
                "type": "integer"
              },
              "documentEnd": {
                "type": "integer"
              },
              "highlight": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "sourceVerification": {
            "type": "object",
            "required": [
              "status",
              "liveSourceFetched"
            ],
            "properties": {
              "status": {
                "enum": [
                  "snapshot_checked",
                  "index_only"
                ]
              },
              "liveSourceFetched": {
                "const": false
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "self": {
                "type": "string"
              }
            }
          }
        },
        "description": " citation.sourceDisplay labels current presentation-policy corpora; legacy pinned corpora retain their original representation."
      },
      "FactResolution": {
        "type": "object",
        "required": [
          "contextId",
          "graphSha256",
          "corpusSha256",
          "fact",
          "transactions",
          "verification"
        ],
        "properties": {
          "contextId": {
            "type": "string"
          },
          "graphSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "corpusSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fact": {
            "type": "object",
            "required": [
              "factId",
              "value",
              "evidenceTxIds"
            ],
            "properties": {
              "factId": {
                "type": "string"
              },
              "value": {},
              "evidenceTxIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lookup": {
                "type": "object"
              }
            }
          },
          "transactions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "scope": {
            "type": "object"
          },
          "verification": {
            "type": "object",
            "properties": {
              "recomputed": {
                "const": true
              },
              "externalLedgerChecked": {
                "const": false
              }
            }
          }
        }
      },
      "CompleteReportVerification": {
        "type": "object",
        "required": [
          "valid",
          "errors",
          "checks",
          "humanReviewRequired",
          "readyForSubmission"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "object",
            "description": "amounts, times, counts, citations, coverage, sourceSnapshots, renderedContent, reportDigest, context",
            "additionalProperties": {
              "type": "object"
            }
          },
          "contextId": {
            "type": "string"
          },
          "reportId": {
            "type": [
              "string",
              "null"
            ]
          },
          "humanReviewRequired": {
            "const": true
          },
          "readyForSubmission": {
            "const": false
          },
          "semanticEntailmentVerified": {
            "const": false
          },
          "externalLedgerChecked": {
            "const": false
          },
          "providerCallAuthenticated": {
            "const": false
          },
          "integrityMetrics": {
            "$ref": "#/components/schemas/IntegrityMetrics"
          }
        }
      },
      "PreparedReviewReport": {
        "type": "object",
        "required": [
          "context",
          "report",
          "verification"
        ],
        "properties": {
          "context": {
            "type": "object",
            "description": "Version-pinned context with per-fact lookup requests and per-citation lookup paths."
          },
          "report": {
            "type": "object",
            "description": "Controlled human-review report, with corpusSha256/contextId/reportId and Markdown."
          },
          "verification": {
            "$ref": "#/components/schemas/CompleteReportVerification"
          }
        },
        "description": " New scope-policy reports expose answerDisposition with explicit reasons. Other reference citations do not answer an abstained question."
      },
      "SourceDisplay": {
        "type": "object",
        "description": "Versioned source metadata classification. It does not establish legal applicability.",
        "properties": {
          "category": {
            "enum": [
              "domestic_law",
              "domestic_guidance",
              "domestic_internal",
              "foreign_reference",
              "other_reference"
            ]
          },
          "label": {
            "type": "string"
          },
          "jurisdiction": {
            "type": "string"
          },
          "sourceKind": {
            "type": "string"
          },
          "effectiveDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "classificationBasis": {
            "const": "registered_source_metadata"
          },
          "legalApplicabilityVerified": {
            "const": false
          },
          "notice": {
            "type": "string"
          }
        }
      },
      "SourceGroup": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "chunkIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "description": "Original citation fields plus retrieval metadata and up to two supportingChunks. sourceDisplay is available for evidencePresentationVersion=1.0.",
        "properties": {
          "chunkId": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sourceDisplay": {
            "$ref": "#/components/schemas/SourceDisplay"
          },
          "supportingChunks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string"
          },
          "corpusSha256": {
            "type": "string"
          },
          "status": {
            "enum": [
              "matched",
              "no_evidence",
              "insufficient_scope"
            ]
          },
          "answerability": {
            "type": "string"
          },
          "evidencePresentationVersion": {
            "const": "1.0"
          },
          "sourceGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceGroup"
            }
          },
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "scopeAssessment": {
            "$ref": "#/components/schemas/QueryScopeAssessment"
          },
          "queryExpansion": {
            "type": "object",
            "description": "Optional diagnostics when a bounded vocabulary bridge is applied. Absent for canonical queries with no new bridge. Source text is unchanged; source/jurisdiction/date/privacy guards apply before retrieval.",
            "properties": {
              "version": {
                "type": "string"
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sourceTextModified": {
                "const": false
              },
              "scopeGuardsAppliedFirst": {
                "const": true
              }
            }
          }
        }
      },
      "EvidenceFitness": {
        "type": "object",
        "description": "Curated, version-pinned references and bounded observable-condition checks. Structural validity is separate from adequate evidence and legal/semantic applicability.",
        "properties": {
          "schemaVersion": {
            "const": "1.0"
          },
          "policyId": {
            "type": "string"
          },
          "policySha256": {
            "type": "string"
          },
          "policyReviewStatus": {
            "const": "developer_curated_pending_domain_review"
          },
          "status": {
            "enum": [
              "needs_more_evidence",
              "no_rule_findings",
              "bounded_requirements_met"
            ]
          },
          "label": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "findingId": {
                  "type": "string"
                },
                "ruleId": {
                  "enum": [
                    "CYCLE",
                    "FAN_IN",
                    "FAN_OUT"
                  ]
                },
                "status": {
                  "enum": [
                    "insufficient_evidence",
                    "partial_reference",
                    "bounded_requirements_met"
                  ]
                },
                "missingEvidence": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "conditionChecks": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "referenceChecks": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "requiredCitationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sufficientForAutomatedDecision": {
            "const": false
          },
          "humanReviewRequired": {
            "const": true
          },
          "rawSnapshotChecked": {
            "const": false
          },
          "semanticEntailmentVerified": {
            "const": false
          },
          "legalApplicabilityVerified": {
            "const": false
          },
          "assessmentSha256": {
            "type": "string"
          }
        }
      },
      "EvidenceAssessmentResponse": {
        "type": "object",
        "properties": {
          "contextId": {
            "type": "string"
          },
          "contextVersion": {
            "type": "string"
          },
          "corpusSha256": {
            "type": "string"
          },
          "graphSha256": {
            "type": "string"
          },
          "status": {
            "enum": [
              "needs_more_evidence",
              "no_rule_findings",
              "bounded_requirements_met",
              "not_configured"
            ]
          },
          "evidenceFitness": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EvidenceFitness"
              },
              {
                "type": "null"
              }
            ]
          },
          "humanReviewRequired": {
            "const": true
          },
          "answerDisposition": {
            "$ref": "#/components/schemas/AnswerDisposition"
          }
        }
      },
      "QueryScopeAssessment": {
        "type": "object",
        "description": "Versioned bounded request/source-scope assessment. A supported scope does not establish answerability.",
        "properties": {
          "policyVersion": {
            "const": "1.0"
          },
          "decision": {
            "enum": [
              "scope_supported",
              "abstain"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "requested": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "available": {
                  "type": "boolean"
                },
                "reasonCode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "wholeRequestAbstained": {
            "type": "boolean"
          },
          "generalAnswerabilityVerified": {
            "const": false
          },
          "classificationBasis": {
            "const": "bounded_request_patterns_and_registered_source_metadata"
          }
        }
      },
      "AnswerDisposition": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "abstained",
              "not_assessed"
            ]
          },
          "scopeAssessment": {
            "$ref": "#/components/schemas/QueryScopeAssessment"
          },
          "abstentionReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "notice": {
            "type": "string"
          }
        }
      },
      "IntegrityMetrics": {
        "type": "object",
        "description": "Mechanical metrics with explicit denominators and coverage. Not semantic entailment or statutory applicability.",
        "properties": {
          "numericFacts": {
            "type": "object",
            "description": "ID-bound fact table, controlled observations and query window; unrestricted prose is not fully audited.",
            "properties": {
              "matched": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "matchRate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "tableCoverage": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "missingFactIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unrestrictedProseFullyAudited": {
                "const": false
              }
            }
          },
          "citations": {
            "type": "object",
            "description": "Allowlisted context chunk ID plus verbatim quote; null with no citations."
          },
          "articleTags": {
            "type": "object",
            "description": "Article tags appear in retrieved context; source interpretation and applicability are not verified."
          },
          "semanticReview": {
            "type": "object",
            "properties": {
              "measured": {
                "const": false
              },
              "normalCommerceReasoningVerified": {
                "const": false
              },
              "humanReviewRequired": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
